generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String
  avatar        String?
  userType      UserType       @default(STUDENT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  suspended     Boolean        @default(false)
  isGuest       Boolean        @default(false)
  flashcardJobs FlashcardJob[]
  flashcardSets FlashcardSet[]
  quizJobs      QuizJob[]
  quizResults   QuizResult[]
  quizzes       Quiz[]
  studySessions StudySession[]
  subscriptions Subscription[]
  usageRecords  UsageRecord[]
  donations     Donation[]

  @@map("users")
}

model BillingPlan {
  id            String         @id @default(cuid())
  name          String         @unique
  slug          String         @unique
  priceUSD      Float
  period        String
  features      Json
  limits        Json
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  description   String?
  highlighted   Boolean        @default(false)
  subscriptions Subscription[]

  @@map("billing_plans")
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  provider           PaymentProvider
  providerId         String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  plan               BillingPlan        @relation(fields: [planId], references: [id])
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId])
  @@map("subscriptions")
}

model UsageRecord {
  id        String        @id @default(cuid())
  userId    String
  resource  UsageResource
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, resource, createdAt])
  @@map("usage_records")
}

model WebhookEvent {
  id          String             @id @default(cuid())
  provider    PaymentProvider
  eventType   String
  payload     Json
  status      WebhookEventStatus @default(PENDING)
  attempts    Int                @default(0)
  maxAttempts Int                @default(5)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime           @default(now())

  @@index([status, createdAt])
  @@map("webhook_events")
}

model FlashcardSet {
  id            String         @id @default(cuid())
  title         String
  subject       String
  description   String?
  isPublic      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userId        String
  shareToken    String?        @unique
  flashcardJobs FlashcardJob[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards         Flashcard[]
  studySessions StudySession[]

  @@index([userId])
  @@map("flashcard_sets")
}

model Flashcard {
  id             String       @id @default(cuid())
  front          String
  back           String
  order          Int
  createdAt      DateTime     @default(now())
  flashcardSetId String
  flashcardSet   FlashcardSet @relation(fields: [flashcardSetId], references: [id], onDelete: Cascade)

  @@index([flashcardSetId])
  @@map("flashcards")
}

model FlashcardJob {
  id             String        @id @default(cuid())
  userId         String
  fileUrl        String?
  text           String?
  title          String
  subject        String
  description    String?
  status         JobStatus     @default(PENDING)
  error          String?
  flashcardSetId String?
  createdAt      DateTime      @default(now())
  flashcardSet   FlashcardSet? @relation(fields: [flashcardSetId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([flashcardSetId])
  @@map("flashcard_jobs")
}

model Quiz {
  id          String         @id @default(cuid())
  title       String
  subject     String
  description String?
  createdAt   DateTime       @default(now())
  userId      String
  isPublic    Boolean        @default(false)
  shareToken  String?        @unique
  quizJobs    QuizJob[]
  questions   QuizQuestion[]
  results     QuizResult[]
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shareToken])
  @@index([userId])
  @@map("quizzes")
}

model QuizQuestion {
  id            String       @id @default(cuid())
  type          QuestionType
  question      String
  options       String[]
  correctAnswer String
  order         Int
  createdAt     DateTime     @default(now())
  quizId        String
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizResult {
  id             String   @id @default(cuid())
  score          Float
  totalQuestions Int
  answers        Json
  completedAt    DateTime @default(now())
  userId         String
  quizId         String
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
  @@map("quiz_results")
}

model QuizJob {
  id                String    @id @default(cuid())
  userId            String
  fileUrl           String?
  text              String?
  title             String
  difficulty        String
  numberOfQuestions String
  questionTypes     String
  status            JobStatus @default(PENDING)
  error             String?
  quizId            String?
  createdAt         DateTime  @default(now())
  quiz              Quiz?     @relation(fields: [quizId], references: [id])
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
  @@map("quiz_job")
}

model StudySession {
  id             String        @id @default(cuid())
  duration       Int
  cardsStudied   Int
  correctAnswers Int
  sessionType    SessionType
  startedAt      DateTime      @default(now())
  endedAt        DateTime?
  userId         String
  flashcardSetId String?
  flashcardSet   FlashcardSet? @relation(fields: [flashcardSetId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([flashcardSetId])
  @@map("study_sessions")
}

model Donation {
  id          String          @id @default(cuid())
  userId      String
  amountUSD   Float
  currency    String          @default("USD")
  amountLocal Float?
  provider    PaymentProvider
  providerId  String?         @unique
  status      DonationStatus  @default(PENDING)
  message     String?
  isAnonymous Boolean         @default(false)
  createdAt   DateTime        @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, createdAt])
  @@map("donations")
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELED
}

enum UserType {
  STUDENT
  TEACHER
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
  PAST_DUE
}

enum PaymentProvider {
  PAYPAL
  LENCO
}

enum UsageResource {
  QUIZ_CREATION
  FLASHCARD_CREATION
}

enum WebhookEventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum JobStatus {
  PENDING_UPLOAD
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum SessionType {
  FLASHCARDS
  QUIZ
  REVIEW
}
